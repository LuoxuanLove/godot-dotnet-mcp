	"prompt_project_orientation_title": "Project orientation workflow",
	"prompt_project_orientation_desc": "Orient an agent in a Godot project with read-only state, health, file, symbol, and scene dependency evidence before choosing an editing or debugging workflow.",
	"prompt_content_authoring_title": "Content authoring workflow",
	"prompt_content_authoring_desc": "Create or modify scenes, nodes, scripts, resources, and small project settings through safe analysis, dry-run previews, and focused validation.",
	"prompt_debug_triage_title": "Debug triage workflow",
	"prompt_debug_triage_desc": "Triage Godot editor, build, runtime, or DAP failures with an evidence-first order that separates logs, project state, runtime diagnostics, and debugger data.",
	"prompt_reference_integrity_title": "Reference integrity workflow",
	"prompt_reference_integrity_desc": "Repair scene, script, signal, export, NodePath, resource UID/path, and C# Resource references after auditing the affected graph.",
	"prompt_runtime_validation_title": "Runtime validation workflow",
	"prompt_runtime_validation_desc": "Run a project or scene, wait for structured markers, arm runtime control, send inputs, and capture frames to validate behavior.",
